---
import Mail from '@lucide/astro/icons/mail';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { site, socials } from '../data/site';
---

<Base title="Contacto">
  <section class="page contact">
    <div class="left">
      <PageTitle eyebrow="Contacto">
        Conversemos sobre <span class="grad-text">inclusión</span> en tu empresa
      </PageTitle>
      <a href={`mailto:${site.email}`} class="mail" data-reveal style="--d:240ms">
        <Mail size={22} class="c-ink" />
        {site.email}
      </a>
    </div>

    <div class="card social" data-reveal style="--d:150ms">
      <h2>Síguenos en redes</h2>
      <ul data-stagger="90">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">
                <span class="badge" style={`background:${s.bg}`}>
                  <img src={s.icon} alt="" width="18" height="18" />
                </span>
                <span class="name">{s.name}</span>
                <ArrowUpRight size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .contact {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: start;
  }
  .left {
    display: grid;
    gap: 22px;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 19px;
    font-weight: 800;
    word-break: break-all;
  }
  .mail :global(svg) {
    flex: none;
  }
  .social {
    border-radius: 28px;
    padding: 32px;
  }
  .social h2 {
    font-size: 20px;
    font-weight: 800;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  ul a {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--soft);
    color: var(--ink);
    font-weight: 800;
    transition: background 0.15s, color 0.15s;
  }
  ul a:hover {
    background: var(--lilac-soft);
    color: var(--violet-dark);
  }
  .badge {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .badge img {
    display: block;
  }
  .name {
    flex: 1;
  }
</style>
