---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NetworkCanvas from '../components/NetworkCanvas.astro';
import { site } from '../data/site';
import logo from '../assets/logo-red.png';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={logo.src} />
    <meta name="theme-color" content="#0B8E6B" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(logo.src, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <NetworkCanvas fixed colors={['#0B8E6B', '#13B3A0', '#1D8FE8', '#6D4FE0']} density={0.45} link={150} opacity={0.55} />
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      // Entrada por secciones: lo que aún no aparece está desenfocado y se enfoca al entrar.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        const step = Number(group.dataset.stagger) || 90;
        Array.from(group.children).forEach((el, i) => {
          const child = el as HTMLElement;
          if (!child.hasAttribute('data-reveal')) child.setAttribute('data-reveal', '');
          child.style.setProperty('--d', `${i * step}ms`);
        });
      });

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        // Bidireccional: se enfoca al entrar y vuelve a desenfocarse al salir (arriba o abajo).
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const el = e.target as HTMLElement;
              const enter = e.isIntersecting;
              // al salir hacia arriba se desvanece "hacia arriba"; hacia abajo, "hacia abajo"
              el.classList.toggle('above', !enter && e.boundingClientRect.top < 0);
              el.classList.toggle('in', enter);
            }
          },
          { threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
  }
  .skip:focus {
    top: 12px;
    color: #fff;
  }
</style>
