---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NetworkCanvas from '../components/NetworkCanvas.astro';
import MotionToggle from '../components/MotionToggle.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir (ruta en /public). */
  image?: string;
  /** Evita indexar la página (p. ej. 404). */
  noindex?: boolean;
}

const { title, description = site.description, image = '/og.png', noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/(^|\/)index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': `${Astro.site}#org`,
      name: site.name,
      alternateName: ['La RED Perú', 'Red de Empresas y Discapacidad'],
      url: Astro.site?.href,
      logo: new URL('/icon-512.png', Astro.site).href,
      image: ogImage,
      email: site.email,
      description: site.description,
      areaServed: { '@type': 'Country', name: 'Perú' },
      knowsAbout: ['Inclusión laboral', 'Discapacidad', 'Diversidad e inclusión', 'Empleabilidad'],
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#web`,
      url: Astro.site?.href,
      name: site.name,
      inLanguage: 'es-PE',
      publisher: { '@id': `${Astro.site}#org` },
    },
  ],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <!-- Íconos -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B8E6B" />

    <!-- Open Graph / redes -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo de la Red de Empresas y Discapacidad – Perú" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (localStorage.getItem('redperu-motion-paused') === '1') document.documentElement.classList.add('motion-paused'); } catch (e) {}
    </script>
  </head>
  <body>
    <NetworkCanvas fixed colors={['#0B8E6B', '#13B3A0', '#1D8FE8', '#6D4FE0']} density={0.45} link={150} opacity={0.55} />
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <MotionToggle />
    <script>
      // Entrada por secciones: lo que aún no aparece está desenfocado y se enfoca al entrar.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        const step = Number(group.dataset.stagger) || 90;
        Array.from(group.children).forEach((el, i) => {
          const child = el as HTMLElement;
          if (!child.hasAttribute('data-reveal')) child.setAttribute('data-reveal', '');
          child.style.setProperty('--d', `${i * step}ms`);
        });
      });

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        // Bidireccional: se enfoca al entrar y vuelve a desenfocarse al salir (arriba o abajo).
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const el = e.target as HTMLElement;
              const enter = e.isIntersecting;
              // al salir hacia arriba se desvanece "hacia arriba"; hacia abajo, "hacia abajo"
              el.classList.toggle('above', !enter && e.boundingClientRect.top < 0);
              el.classList.toggle('in', enter);
            }
          },
          { threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
  }
  .skip:focus {
    top: 12px;
    color: #fff;
  }
</style>
