---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import logo from '../assets/logo-red.png';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={logo.src} />
    <meta name="theme-color" content="#0B8E6B" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(logo.src, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      // Entrada por secciones: lo que aún no aparece está desenfocado y se enfoca al entrar.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      document.querySelectorAll<HTMLElement>('[data-stagger]').forEach((group) => {
        const step = Number(group.dataset.stagger) || 90;
        Array.from(group.children).forEach((el, i) => {
          const child = el as HTMLElement;
          if (!child.hasAttribute('data-reveal')) child.setAttribute('data-reveal', '');
          child.style.setProperty('--d', `${i * step}ms`);
        });
      });

      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (reduce || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target as HTMLElement;
                el.classList.add('in');
                io.unobserve(el);
                // al terminar, liberar el elemento para que sus propias transiciones (hover) sean ágiles
                const delay = parseInt(el.style.getPropertyValue('--d')) || 0;
                setTimeout(() => {
                  el.removeAttribute('data-reveal');
                  el.classList.remove('in');
                }, delay + 1200);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
        );
        targets.forEach((el) => {
          // lo que ya asoma en la primera pantalla entra de inmediato (con su retardo escalonado)
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('in');
            const delay = parseInt(el.style.getPropertyValue('--d')) || 0;
            setTimeout(() => {
              el.removeAttribute('data-reveal');
              el.classList.remove('in');
            }, delay + 1200);
          } else {
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 100;
    background: var(--ink);
    color: #fff;
    padding: 10px 16px;
    border-radius: 999px;
    font-weight: 800;
  }
  .skip:focus {
    top: 12px;
    color: #fff;
  }
</style>
