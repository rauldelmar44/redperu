---
import { Image } from 'astro:assets';
import type { Logo } from '../data/members';

interface Props {
  logos: Logo[];
}
const { logos } = Astro.props;
---

<ul class="grid" data-stagger="30">
  {
    logos.map((m) => (
      <li class="logo">
        <Image src={m.src} alt={m.alt} width={300} loading="lazy" />
      </li>
    ))
  }
</ul>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 12px;
  }
  .logo {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 16px;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }
  .logo:hover {
    box-shadow: 0 10px 24px rgba(109, 79, 224, 0.15);
    border-color: var(--lilac-text);
  }
  .logo :global(img) {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>
